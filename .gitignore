# =============================================================================
# CustomAndroidEmulator — .gitignore
# =============================================================================

# ----------------------------------------------------------------------------
# Build system
# ----------------------------------------------------------------------------
build/
build_ninja/
CMakeFiles/
CMakeCache.txt
CMakeConfigureLog.yaml
cmake_install.cmake
CTestTestfile.cmake
*.cmake
!CMakeLists.txt
Makefile
*.ninja
.ninja_*
install_manifest.txt

# ----------------------------------------------------------------------------
# Compiled output
# ----------------------------------------------------------------------------
*.exe
*.dll
*.so
*.so.*
*.a
*.lib
*.pdb
*.ilk
*.exp
*.obj
*.o

# ----------------------------------------------------------------------------
# Qt / MOC / UIC / RCC generated files
# ----------------------------------------------------------------------------
*_autogen/
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qm

# ----------------------------------------------------------------------------
# IDE & editor
# ----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters
*.code-workspace
.clangd/
.cache/
compile_commands.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------------
# ROM storage — extracted ROMs, large partition images, intermediate files
# ----------------------------------------------------------------------------
roms/
*.img
*.dat
*.dat.br
*.new.dat
*.new.dat.br
*.transfer.list
*.patch.dat
*.sparse.img
*.raw
*.elf
*.bin
*.zip
!tests/**/*.zip
mock_rom.zip
mock_rom2.zip
recovery_fs/
*.cpio
*.gz

# ----------------------------------------------------------------------------
# Kernel analysis temporaries
# ----------------------------------------------------------------------------
kernel.raw
kernel.elf
kconfig.gz
kconfig.txt

# ----------------------------------------------------------------------------
# Log & session files
# ----------------------------------------------------------------------------
*.log
logs/
test_logs/
logger/sessions/
*.bak

# ----------------------------------------------------------------------------
# Boot session exports
# ----------------------------------------------------------------------------
boot_*.json
boot_*.qemu.txt

# ----------------------------------------------------------------------------
# Temporary boot asset directories
# ----------------------------------------------------------------------------
_tmp_boot/

# ----------------------------------------------------------------------------
# Python / scripts
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
dtbo_extracted.dts
kernel_extracted.dts
kernel_extracted.dtb
virt.dtb
virt.dts
extracted_fstab/
docs/diagnostic_run_report.txt
scratch/test_ramoops.ps1

# ----------------------------------------------------------------------------
# Debug/trace scripts folder (one-off GDB/QEMU session scripts)
# ----------------------------------------------------------------------------
scripts/

# ----------------------------------------------------------------------------
# Loose root-level debug artifacts
# ----------------------------------------------------------------------------
# DTB/DTS intermediates generated during debugging
qemu_clusters.dtb
qemu_clusters.dts
qemu_generated.dtb
qemu_generated.dts
virt_qcom_gcc.dtb
virt_qcom_gcc.dts
virt_timer_fix.dtb
virt_timer_fix.dts

# Framebuffer captures
guest_ramfb_raw.bin
guest_ramfb_raw.png
guest_ramfb_capture_*.png

# One-off diagnostic C++ files (not part of the main source)
diagnose_ramfb.cpp
test_binder_integration.cpp
test_gdb_integration.cpp
test_input_integration.cpp
test_instruction_tracer.cpp
test_logger_integration.cpp
test_runtime_integration.cpp
test_smc_integration.cpp
test_storage_integration.cpp

# tools/ directory (generated tool binaries & outputs)
tools/

# ----------------------------------------------------------------------------
# Allow diagnostic reports and artifact logs
# ----------------------------------------------------------------------------
!diagnostics/**/*.log
!diagnostics/**/*.md
!diagnostics/**/*.json
!artifacts/**/*.dts
!artifacts/**/*.dtb
!reference/**/*
boot_ramdisk.gz.orig
boot_ramdisk.gz.bak_z5u
